<Window x:Class="Klangkiste.HilfeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klangkiste-Hilfe"
        Width="1050"
        Height="700"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="Klangkiste.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SucheTextBox" Grid.Row="0" Margin="0,0,0,10" Height="30" VerticalContentAlignment="Center" ToolTip="Hilfethemen durchsuchen" TextChanged="SucheTextBox_TextChanged" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ThemenListe" Grid.Column="0" DisplayMemberPath="Titel" SelectionChanged="ThemenListe_SelectionChanged" />
            <Border Grid.Column="2" Padding="16" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="InhaltTextBlock" TextWrapping="Wrap" FontSize="14" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>


