<Window x:Class="Klangkiste.DesignKonfliktDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Design bereits vorhanden"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Ein Design mit diesem Namen ist bereits vorhanden." TextWrapping="Wrap" />
        <TextBlock x:Name="DesignnameTextBlock" Margin="0,8,0,16" FontWeight="SemiBold" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Width="110" Margin="0,0,8,0" Content="Überschreiben" Click="Ueberschreiben_Click" />
            <Button Width="110" Margin="0,0,8,0" Content="Umbenennen" Click="Umbenennen_Click" />
            <Button Width="90" Content="Abbrechen" Click="Abbrechen_Click" />
        </WrapPanel>
    </StackPanel>
</Window>
