<Window x:Class="Klangkiste.EinstellungenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="820"
        Height="650"
        MinWidth="700"
        MinHeight="520"
                WindowStartupLocation="CenterOwner"
        Icon="Klangkiste.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Player">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                                                <GroupBox Header="Audio-Player" Margin="0,0,0,12">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profil:" />
                                <ComboBox x:Name="AudioProfilComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="AudioProfil_SelectionChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Programmdatei:" />
                                <TextBox x:Name="AudioExeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,8,0" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Padding="12,4" Content="Durchsuchen..." Click="AudioExeDurchsuchen_Click" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Übergabe:" />
                                <ComboBox x:Name="AudioUebergabeComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" SelectionChanged="AudioUebergabe_SelectionChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Argumente:" />
                                <TextBox x:Name="AudioArgumenteTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ToolTip="Platzhalter: {playlist}, {file}, {first}" LostFocus="AudioArgumente_LostFocus" />
                                <Button Grid.Row="4" Grid.Column="1" MinWidth="100" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Testen" Click="AudioPlayerTesten_Click" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Video-Player">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Profil:" />
                                <ComboBox x:Name="VideoProfilComboBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="VideoProfil_SelectionChanged" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Programmdatei:" />
                                <TextBox x:Name="VideoExeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,8,8,0" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Padding="12,4" Content="Durchsuchen..." Click="VideoExeDurchsuchen_Click" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Übergabe:" />
                                <ComboBox x:Name="VideoUebergabeComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" SelectionChanged="VideoUebergabe_SelectionChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Argumente:" />
                                <TextBox x:Name="VideoArgumenteTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ToolTip="Platzhalter: {playlist}, {file}, {first}" LostFocus="VideoArgumente_LostFocus" />
                                <Button Grid.Row="4" Grid.Column="1" MinWidth="100" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Testen" Click="VideoPlayerTesten_Click" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Auswahl">
                <StackPanel Margin="16">
                    <TextBlock FontWeight="SemiBold" Text="Auswahlmodus" />
                    <RadioButton x:Name="NormalModusRadioButton" Margin="0,10,0,0" Content="Normaler Modus – Strg-/Shift-Auswahl" Checked="Auswahlmodus_Checked" />
                    <RadioButton x:Name="KontrollkaestchenModusRadioButton" Margin="0,6,0,0" Content="Kontrollkästchen-Modus" Checked="Auswahlmodus_Checked" />
                    <RadioButton x:Name="HybridModusRadioButton" Margin="0,6,0,0" Content="Hybrid-Modus" Checked="Auswahlmodus_Checked" />
                    <CheckBox x:Name="OrdneruebergreifendCheckBox" Margin="0,18,0,0" Content="Ordnerübergreifende Auswahl" IsEnabled="False" Click="Ordneruebergreifend_Click" />
                    <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="Gray" Text="Im Kontrollkästchen- und Hybrid-Modus können Markierungen über mehrere Ordner hinweg erhalten bleiben." />
                </StackPanel>
            </TabItem>

            <TabItem Header="Dateiliste">
                                <StackPanel Margin="16">
                                        <CheckBox x:Name="GitternetzCheckBox" Content="Gitternetz anzeigen" Click="GitternetzAnzeigen_Click" />
                    <CheckBox x:Name="SeitentrennerFixierenCheckBox" Margin="0,10,0,0" Content="Seitentrenner fixieren" Click="SeitentrennerFixieren_Click" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Linienstärke:" />
                        <Slider x:Name="GitternetzstaerkeSlider" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                Minimum="1" Maximum="5" TickFrequency="1" TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True" ValueChanged="Gitternetzstaerke_ValueChanged" />
                        <TextBlock x:Name="GitternetzstaerkeWertText" Grid.Column="2" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray"
                               Text="Die Farbe der Trennlinien richtet sich automatisch nach dem gewählten Design (Hell/Dunkel)." />
                    <Button MinWidth="150" HorizontalAlignment="Left" Margin="0,18,0,0" Content="Spalten anpassen..." Click="SpaltenAnpassen_Click" />
                </StackPanel>
            </TabItem>

                        <TabItem Header="Design">
                <StackPanel Margin="16">
                    <GroupBox Header="Modus">
                        <StackPanel Margin="10">
                            <ComboBox x:Name="DesignModusComboBox" Width="220" HorizontalAlignment="Left" SelectionChanged="DesignModus_SelectionChanged" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray"
                                       Text="Automatisch folgt der Windows-Einstellung für App-Hell/Dunkel. Die Farben sind für jeden Modus fest hinterlegt." />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Schrift" Margin="0,12,0,0">
                        <Grid Margin="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Schriftart:" />
                            <ComboBox x:Name="SchriftartComboBox" Grid.Row="0" Grid.Column="1" Width="280" HorizontalAlignment="Left" SelectionChanged="Schriftart_SelectionChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center" Text="Schriftgröße:" />
                            <ComboBox x:Name="SchriftgroesseComboBox" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0" SelectionChanged="Schriftgroesse_SelectionChanged" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" MinWidth="90" Margin="0,10,0,0" HorizontalAlignment="Right" Content="Schließen" IsCancel="True" />
    </Grid>
</Window>


