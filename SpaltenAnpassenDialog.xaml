<Window x:Class="Klangkiste.SpaltenAnpassenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spalten anpassen"
        Width="360"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   Text="Spalten auswählen und per Drag-and-drop anordnen:" />

        <ListView x:Name="SpaltenListe"
                  Grid.Row="1"
                  AllowDrop="True"
                  PreviewMouseLeftButtonDown="SpaltenListe_MouseLeftButtonDown"
                  PreviewMouseMove="SpaltenListe_MouseMove"
                  Drop="SpaltenListe_Drop">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Ueberschrift}"
                              IsChecked="{Binding Sichtbar, Mode=TwoWay}"
                              Click="SpalteSichtbarkeit_Click"
                              Padding="4" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2"
                Width="90"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Content="Schließen"
                IsCancel="True" />
    </Grid>
</Window>
